# Nusxa oling: backend/.env — va qiymatlarni to'ldiring.
# Netlify'da esa bular Site configuration → Environment variables ga yoziladi.
# Bu qiymatlar faqat serverda turadi, sayt kodida ko'rinmaydi.

PORT=3000

# CRM arizalarni GET /api/arizalar?key=... orqali oladi
ARIZA_TOKEN=

# Ixtiyoriy: har bir ariza Telegram guruhga ham keladi
TG_TOKEN=
TG_CHAT_ID=
