# Nusxa oling: frontend/.env — va qiymatlarni to'ldiring.
# Eslatma: VITE_ bilan boshlangan qiymatlar sahifa kodida ko'rinadi — bu yerga token yozmang!
# Tokenlar (Telegram, ARIZA_TOKEN) backend/.env da turadi.

# Backend manzili. Bo'sh qoldiring — sayt va backend bitta Netlify saytida bo'lsa.
# Backend boshqa serverda bo'lsa: VITE_API_URL=https://api.sizning-sayt.uz
VITE_API_URL=

# Ariza yuborilgach ochiladigan Telegram kanal
VITE_TG_CHANNEL=https://t.me/Tasnim_Akademiya

# Pastdagi "Qo'ng'iroq qiling" tugmasi uchun
VITE_PHONE=+998000000000
VITE_PHONE_LABEL=+998 [TELEFON]
