# Nusxa oling: .env  — va qiymatlarni to'ldiring.
# Arizalar Telegram guruh/botga keladi:
#   1) @BotFather orqali bot yarating → TOKEN
#   2) Botni guruhga qo'shing, CHAT_ID ni oling
# Eslatma: VITE_ bilan boshlangan qiymatlar sahifa kodida ko'rinadi.
# Xavfsizroq usul — VITE_SUBMIT_URL ga o'z backend manzilingizni yozing.
VITE_TG_TOKEN=
VITE_TG_CHAT_ID=
VITE_SUBMIT_URL=
# Netlify'da funksiya bilan ishlaganda (CRM uchun) — Telegram tokenini bu yerga EMAS,
# Netlify → Environment variables ga TG_TOKEN / TG_CHAT_ID / ARIZA_TOKEN qilib yozing:
# VITE_SUBMIT_URL=/.netlify/functions/arizalar

# CRM bazasi (Supabase) — arizalar to'g'ridan-to'g'ri CRM'ning "Reklama" bo'limiga tushadi.
# Qiymatlar: Supabase → Project Settings → API (Project URL va publishable/anon kalit).
# Oldin Supabase SQL Editor'da supabase/reklama_lead.sql ni bir marta ishga tushiring.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ariza yuborilgach ochiladigan Telegram kanal
VITE_TG_CHANNEL=https://t.me/Tasnim_Akademiya

# Pastdagi "Qo'ng'iroq qiling" tugmasi uchun
VITE_PHONE=+998000000000
VITE_PHONE_LABEL=+998 [TELEFON]
